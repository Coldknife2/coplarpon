{
  "name": "coplarpon",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:server": "npm run dev -w @coplarpon/server",
    "dev:client": "npm run dev -w @coplarpon/client",
    "test": "npm run test -w @coplarpon/engine",
    "sim": "npm run sim -w @coplarpon/engine",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p apps/server && tsc --noEmit -p apps/client",
    "build": "npm run build -w @coplarpon/client"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
