{
  "name": "@coplarpon/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --external:bufferutil --external:utf-8-validate --outfile=dist/index.cjs"
  },
  "dependencies": {
    "@coplarpon/engine": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.25.0"
  }
}
